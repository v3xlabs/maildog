          "substring": "text/calendar"
        },
        {
          "type": "headerContains",
          "name": "subject",
          "substring": "invitation"
        },
        {
          "type": "headerContains",
          "name": "subject",
          "substring": "meeting request"
        },
        {
          "type": "headerContains",
          "name": "subject",
          "substring": "calendar"
        },
        {
          "type": "headerEquals",
          "name": "method",
          "value": "REQUEST"
        }
      ]
    },
    "actions": [
      {
        "type": "addLabel",
